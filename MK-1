/* ================================================================
   SECTION 3 - ASCII ARTIST  (ForgeArtist)
   Draws the OUTPUT right now so you can see what your generated
   code will print. It mirrors exactly what the generated code does.
   ================================================================ */

class ForgeArtist {
public:
    void draw(const Request& req) {
        cout << "\n" + string(60, '-') + "\n";
        cout << "  PREVIEW - this is what your code will print:\n";
        cout << string(60, '-') + "\n";

        switch (req.intent) {
            case Intent::SQUARE:      drawSquare(req);  break;
            case Intent::RECTANGLE:   drawRectangle(req); break;
            case Intent::TRIANGLE:    drawTriangle(req); break;
            case Intent::DIAMOND:     drawDiamond(req); break;
            case Intent::CIRCLE:      drawCircle(req); break;
            case Intent::STAR:        drawStar(req); break;
            case Intent::PATTERN:     drawPattern(req); break;
            case Intent::SQRT:        drawSqrt(req); break;
            case Intent::POW:         drawPow(req); break;
            case Intent::FACTORIAL:   drawFactorial(req); break;
            case Intent::FIBONACCI:   drawFibonacci(req); break;
            case Intent::TIMES_TABLE: drawTimesTable(req); break;
            case Intent::PRIME:       drawPrime(req); break;
            case Intent::CALCULATOR:  drawCalculator(req); break;
            case Intent::HELLO:       drawHello(req); break;
            default:                  break;
        }
        cout << string(60, '-') + "\n\n";
    }

private:
    /* ---------- shape drawing ---------- */
    void drawSquare(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (!r.hollow || i == 1 || i == n || j == 1 || j == n)
                    cout << r.fill << " ";
                else
                    cout << "  ";
            }
            cout << "\n";
        }
    }

    void drawRectangle(const Request& r) {
        int h = max(2, static_cast<int>(r.num1));
        int w = max(3, static_cast<int>(r.num2));
        for (int i = 1; i <= h; i++) {
            for (int j = 1; j <= w; j++) cout << r.fill << " ";
            cout << "\n";
        }
    }

    void drawTriangle(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n - i; j++) cout << "  ";
            for (int k = 1; k <= 2 * i - 1; k++) {
                if (!r.hollow || i == n || k == 1 || k == 2 * i - 1)
                    cout << r.fill << " ";
                else
                    cout << "  ";
            }
            cout << "\n";
        }
    }

    void drawDiamond(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n - i; j++) cout << "  ";
            for (int k = 1; k <= 2 * i - 1; k++) cout << r.fill << " ";
            cout << "\n";
        }
        for (int i = n - 1; i >= 1; i--) {
            for (int j = 1; j <= n - i; j++) cout << "  ";
            for (int k = 1; k <= 2 * i - 1; k++) cout << r.fill << " ";
            cout << "\n";
        }
    }

    void drawCircle(const Request& r) {
        int rad = max(2, static_cast<int>(r.num1));
        for (int y = rad; y >= -rad; y--) {
            for (int x = -2 * rad; x <= 2 * rad; x++) {
                double dist = sqrt((x / 2.0) * (x / 2.0) + y * y);
                cout << (fabs(dist - rad) <= 1.0 ? r.fill : ' ');
            }
            cout << "\n";
        }
    }

    void drawStar(const Request& r) {
        int n = max(3, static_cast<int>(r.num1));
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n - i; j++) cout << " ";
            for (int k = 1; k <= 2 * i - 1; k++) cout << r.fill;
            cout << "\n";
        }
        for (int i = n - 1; i >= 1; i--) {
            for (int j = 1; j <= n - i; j++) cout << " ";
            for (int k = 1; k <= 2 * i - 1; k++) cout << r.fill;
            cout << "\n";
        }
    }

    void drawPattern(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        int type = static_cast<int>(r.num2);
        if (type == 1) {              // Floyd's triangle
            int counter = 1;
            for (int i = 1; i <= n; i++) {
                for (int j = 1; j <= i; j++) cout << counter++ << " ";
                cout << "\n";
            }
        } else if (type == 2) {       // countdown
            for (int i = n; i >= 1; i--) {
                for (int j = 1; j <= i; j++) cout << j << " ";
                cout << "\n";
            }
        } else if (type == 3) {       // letters
            for (int i = 1; i <= n; i++) {
                for (int j = 1; j <= i; j++)
                    cout << static_cast<char>('A' + j - 1) << " ";
                cout << "\n";
            }
        } else {                      // default number pattern
            for (int i = 1; i <= n; i++) {
                for (int j = 1; j <= i; j++) cout << i << " ";
                cout << "\n";
            }
        }
    }

    /* ---------- math drawing ---------- */
    void drawSqrt(const Request& r) {
        double ans = sqrt(r.num1);
        cout << "   sqrt(" << r.num1 << ") = " << fixed << setprecision(4) << ans << "\n";
    }

    void drawPow(const Request& r) {
        cout << "   " << r.num1 << " ^ " << r.num2 << " = " << fixed
             << setprecision(0) << pow(r.num1, r.num2) << "\n";
    }

    void drawFactorial(const Request& r) {
        int n = max(0, static_cast<int>(r.num1));
        long long fact = 1;
        for (int i = 2; i <= n; i++) fact *= i;
        cout << "   " << n << "! = " << fact << "\n";
    }

    void drawFibonacci(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        long long a = 0, b = 1;
        cout << "   ";
        for (int i = 1; i <= n; i++) {
            cout << a << (i < n ? ", " : "\n");
            long long next = a + b;
            a = b; b = next;
        }
    }

    void drawTimesTable(const Request& r) {
        int n = max(1, static_cast<int>(r.num1));
        for (int i = 1; i <= 10; i++)
            cout << "   " << n << " x " << i << " = " << n * i << "\n";
    }

    void drawPrime(const Request& r) {
        int n = max(2, static_cast<int>(r.num1));
        vector<string> dummy = tokenize(r.raw);
        bool listMode = hasWord(dummy, {"list", "all", "upto", "up", "to", "till", "until", "below"});
        if (listMode) {
            cout << "   Primes up to " << n << ": ";
            for (int num = 2; num <= n; num++) {
                bool isPrime = true;
                for (int i = 2; i * i <= num; i++)
                    if (num % i == 0) { isPrime = false; break; }
                if (isPrime) cout << num << " ";
            }
            cout << "\n";
        } else {
            bool isPrime = true;
            if (n < 2) isPrime = false;
            for (int i = 2; i * i <= n; i++)
                if (n % i == 0) { isPrime = false; break; }
            cout << "   " << n << (isPrime ? " is PRIME." : " is NOT prime.") << "\n";
        }
    }

    void drawCalculator(const Request& r) {
        double a = r.num1, b = r.num2;
        cout << fixed << setprecision(4);
        if (b == -5)      cout << "   sin(" << a << ") = " << sin(a) << "\n";
        else if (b == -6) cout << "   cos(" << a << ") = " << cos(a) << "\n";
        else if (b == -7) cout << "   tan(" << a << ") = " << tan(a) << "\n";
        else if (b == -1) cout << "   " << a << " - " << (-b - 1 == 0 ? 0 : 0)
                                  << " ... (say 'minus' clearly, e.g. 5 minus 3)\n";
        else if (b == -2) cout << "   " << a << " x ? ... (say 'times', e.g. 5 times 3)\n";
        else if (b == -3) cout << "   " << a << " / ? ... (say 'divided by', e.g. 10 divided by 2)\n";
        else if (b == -4) cout << "   " << a << " % ? ... (say 'mod', e.g. 10 mod 3)\n";
        else              cout << "   " << a << " + " << b << " = " << a + b << "\n";
    }

    void drawHello(const Request& /*r*/) {
        cout << "   Hello, World!\n   I am learning C++ with CodeForge AI.\n";
    }
};
/* ================================================================
   SECTION 4 - FORGE BRAIN  (the orchestrator)
   Ties the parser, code generator and artist together and handles
   the conversation with the user.
   ================================================================ */

class ForgeBrain {
public:
    void run() {
        greet();
        string line;
        while (true) {
            cout << "\nYou: ";
            if (!getline(cin, line)) break;
            if (line.empty()) continue;

            Request req = parser.parse(line);

            if (req.intent == Intent::QUIT) {
                cout << "CodeForge AI: Goodbye! Happy coding!\n";
                break;
            }
            if (req.intent == Intent::HELP || req.intent == Intent::UNKNOWN) {
                if (req.intent == Intent::UNKNOWN)
                    cout << "CodeForge AI: I did not understand that, so here is "
                            "what I CAN do:\n";
                showHelp();
                continue;
            }

            cout << "CodeForge AI: Understood! Here is your code AND the "
                    "output it will create:\n";

            /* 1) show the generated code */
            string code = generator.generate(req);
            printCode(code);

            /* 2) draw the live preview */
            artist.draw(req);

            /* 3) tell the user how to run it */
            cout << "  -> Save the code as a .cpp file, then compile and run:\n"
                 << "        g++ mycode.cpp -o mycode && ./mycode\n"
                 << "  -> OR paste it into any online C++ compiler.\n";
        }
    }

private:
    ForgeParser   parser;
    CodeForge     generator;
    ForgeArtist   artist;

    void greet() {
        cout << "\n" + string(60, '#') + "\n";
        cout << "#  CODEFORGE AI v1.0                                    #\n";
        cout << "#  A local semantic AI: type English, get C++ code!     #\n";
        cout << "#  All thinking happens on YOUR machine.                #\n";
        cout << string(60, '#') + "\n";
        cout << "  Type 'help' to see everything I can do,\n";
        cout << "  type 'quit' to exit.\n";
    }

    void showHelp() {
        cout << "\n" + string(60, '=') + "\n";
        cout << "  WHAT CODEFORGE AI CAN BUILD FOR YOU\n";
        cout << string(60, '=') + "\n";
        cout << "  SHAPES (drawn with nested for-loops)\n";
        cout << "    square (of size N)        - e.g. \"draw a square of size 5\"\n";
        cout << "    hollow square             - e.g. \"hollow square size 7\"\n";
        cout << "    rectangle / box           - e.g. \"rectangle 4 by 8\"\n";
        cout << "    triangle / pyramid        - e.g. \"pyramid size 6\"\n";
        cout << "    diamond                   - e.g. \"diamond of size 5\"\n";
        cout << "    circle / round            - e.g. \"draw a circle radius 6\"\n";
        cout << "    star                      - e.g. \"star size 5\"\n";
        cout << "    pattern                   - e.g. \"number pattern 5\"\n";
        cout << "                             \"floyd pattern 5\"\n";
        cout << "                             \"countdown pattern 6\"\n";
        cout << "                             \"letter pattern 4\"\n";
        cout << "  MATH (using <cmath> functions)\n";
        cout << "    sqrt of N                 - e.g. \"sqrt of 144\"\n";
        cout << "    pow / power               - e.g. \"pow 2 to the 10\"\n";
        cout << "                             \"2 raised to 8\"\n";
        cout << "                             \"cube of 4\", \"square of 9\"\n";
        cout << "    factorial                 - e.g. \"factorial of 7\"\n";
        cout << "    fibonacci                 - e.g. \"fibonacci 12 terms\"\n";
        cout << "    prime                     - e.g. \"is 29 prime\"\n";
        cout << "                             \"list primes up to 50\"\n";
        cout << "    times table               - e.g. \"multiplication table of 12\"\n";
        cout << "    calculator                - e.g. \"add 99 and 1\"\n";
        cout << "                             \"sin 1.5\", \"cos 0\", \"tan 0.5\"\n";
        cout << "  CUSTOMISING\n";
        cout << "    \"square of size 4 with @\"  -> draws with any character\n";
        cout << "    \"hollow triangle of 8 with #\"\n";
        cout << string(60, '=') + "\n";
    }

    /* print the generated code inside a nice box */
    void printCode(const string& code) {
        cout << "\n  +-- GENERATED CODE (copy from here) -------------------------+\n";
        istringstream stream(code);
        string line;
        while (getline(stream, line)) {
            if (line.empty()) line = " ";
            cout << "  | " << line;
            for (size_t i = line.size(); i < 58; i++) cout << " ";
            cout << " |\n";
        }
        cout << "  +--------------------------------------------------------------+\n";
    }
};

